[
    {
        "project_name": "BWIC",
        "rule": {
            "timestamp": "^(\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3})",
            "timestamp_format": "MM-dd hh:mm:ss.SSS",
            "process": "^\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3}\\s+(\\d+)",
            "thread": "^\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3}\\s+\\d+\\s+(\\d+)",
            "level": "^\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3}\\s+\\d+\\s+\\d+\\s+([A-Z{1}])",
            "module": "^\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3}\\s+\\d+\\s+\\d+\\s+[A-Z{1}]\\s+([^:]+)",
            "class": "",
            "class_line": "",
            "tag": "^\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3}\\s+\\d+\\s+\\d+\\s+[A-Z{1}]\\s+[^:]+:\\s*([^\\s+]+)",
            "message": "^\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}.\\d{3}\\s+\\d+\\s+\\d+\\s+[A-Z{1}]\\s+[^:]+:\\s*[^\\s+]+\\s*(.*)$"
        },
        "default_module": "system",
        "modules": [
            {
                "name": "DeviceService",
                "scenes": [
                    {
                        "name": "System问题分析",
                        "keywords": [
                            {
                                "keyword": "--------- beginning of main",
                                "desc": "系统启动",
                                "mode": "word",
                                "color": "#ff3333"
                            },
                            {
                                "keyword": "00 09 0a",
                                "desc": "系统重启原因",
                                "mode": "word",
                                "color": "#33ff33"
                            },
                            {
                                "keyword": "onLocalAccChanged: false",
                                "desc": "ACC关闭",
                                "mode": "word",
                                "color": "#33ff33"
                            },
                            {
                                "keyword": "onLocalAccChanged: true",
                                "desc": "ACC打开",
                                "mode": "word",
                                "color": "#33ff33"
                            },
                            {
                                "keyword": "BluetoothManagerService: ACTION_QB_POWERON",
                                "desc": "唤醒",
                                "mode": "word",
                                "color": "#33ff33"
                            },
                            {
                                "keyword": "BluetoothManagerService: ACTION_QB_POWEROFF",
                                "desc": "休眠",
                                "mode": "word",
                                "color": "#33ff33"
                            },
                            {
                                "keyword": "ActivityTaskManager: START u0",
                                "desc": "打开应用",
                                "mode": "word",
                                "color": "#33ff33"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    {
        "project_name": "SpringBoot项目",
        "rule": {
            "timestamp": "(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})",
            "timestamp_format": "YYYY-MM-dd hh:mm:ss",
            "process": "",
            "thread": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2} \\[([^\\]]+)\\]",
            "level": "(ERROR|INFO|WARN|DEBUG|TRACE|FATAL)",
            "module": "",
            "class": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2} \\[[^\\]]+\\] \\w+\\s+([a-zA-Z][\\w.]*)",
            "class_line": "",
            "tag": "",
            "message": "-\u003e\\s*(.*)"
        },
        "modules": null
    },
    {
        "project_name": "默认项目2",
        "rule": {
            "timestamp": "(\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})",
            "timestamp_format": "MM-dd hh:mm:ss",
            "process": "",
            "thread": "$[^$]+$",
            "level": "(ERROR|INFO|WARN|DEBUG|TRACE|FATAL)",
            "module": "",
            "class": "([a-zA-Z0-9.$]+)\\s*-\u003e",
            "class_line": "",
            "tag": "",
            "message": ".*"
        },
        "modules": null
    }
]
