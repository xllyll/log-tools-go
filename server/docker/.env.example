# 复制为 .env 后修改：cp .env.example .env

# 镜像名（不含仓库前缀）
IMAGE_NAME=log-tools-server
IMAGE_TAG=latest

# 镜像仓库，例如 registry.cn-hangzhou.aliyuncs.com/your-ns
# 留空则只本地构建，不 push
REGISTRY=

# 构建后是否 push（需配置 REGISTRY 且已 docker login）
PUSH=true

# 构建后是否启动 compose（需 config/config.yaml）
RUN_AFTER_BUILD=false

# compose 端口
HOST_PORT=8080

# 导出离线包 docker save（无仓库时用）
SAVE_TAR=false
